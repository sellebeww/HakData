# Salin ke .env di root repo: cp .env.example .env. Hanya dev; JANGAN pakai nilai ini di produksi.
# API memvalidasi variabel ini saat boot (apps/api/src/env.ts) dan berhenti bila salah.
DATABASE_URL=postgresql://hakdata:hakdata_dev@localhost:5433/hakdata
RABBITMQ_URL=amqp://hakdata:hakdata_dev@localhost:5673
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
UPLOAD_DIR=./storage/evidence
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Mailpit (SMTP dev): email verifikasi akun. UI: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
# Hanya web: alamat API untuk proxy /api (default http://localhost:4000)
# API_URL=http://localhost:4000
MAIL_FROM=no-reply@hakdata.example
# Batas permintaan per IP per menit untuk endpoint auth (register/login/refresh/verifikasi)
AUTH_RATE_LIMIT=10
# Demo: percepat waktu. 1 = waktu nyata. 1440 = 72 jam menjadi 3 menit. Di produksi != 1 ditolak kecuali DEMO_MODE=true.
DEADLINE_TIME_SCALE=1
# DEMO_MODE=true juga mengaktifkan perusahaan simulasi (seed: toko membalas tepat waktu, dompet terlambat, seluler diam).
# Demo cepat: DEADLINE_TIME_SCALE=86400 (72 jam menjadi 3 detik).
DEMO_MODE=false
# Jendela pengingat "menjelang estimasi tenggat" (jam, sebelum skala)
REMINDER_APPROACHING_HOURS=24
# Proxy yang X-Forwarded-For-nya dipercaya untuk IP asli (rate limit). Default: loopback, linklocal, uniquelocal (proxy Next di jaringan privat)
# TRUST_PROXY=loopback, linklocal, uniquelocal
