{
  "info": {
    "_postman_id": "bd0d9520-d14f-564b-83b5-d65b07f57895",
    "name": "Hak Data API",
    "description": "Koleksi lengkap API Hak Data (GraphQL lewat proxy web /api + REST unggah bukti + health).\n\nJalankan berurutan (Collection Runner atau `newman run docs/postman/HakData.postman_collection.json -e docs/postman/HakData.local.postman_environment.json --working-dir .`).\nPrasyarat: `docker compose up --build` (atau `pnpm dev` + Mailpit). Setiap request punya test otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Kesehatan",
      "description": "",
      "item": [
        {
          "name": "GET /health (langsung ke API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"API sehat (DB + RabbitMQ up)\", () => { if (b.status !== \"ok\") throw new Error(JSON.stringify(b)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/health",
              "host": ["{{apiUrl}}"],
              "path": ["health"]
            },
            "description": "200 bila DB dan RabbitMQ sehat, 503 bila salah satu mati. Tanpa detail error (endpoint publik)."
          }
        }
      ]
    },
    {
      "name": "1. Autentikasi",
      "description": "Daftar → verifikasi email (token diambil dari Mailpit) → masuk. Sesi = cookie httpOnly; Postman/Newman menyimpannya otomatis per domain.",
      "item": [
        {
          "name": "Daftar akun baru",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newEmail\", `postman.${Date.now()}@hakdata.test`);",
                  "pm.collectionVariables.set(\"newPassword\", \"PostmanPass!2026\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"HTTP 200\", () => { if (pm.response.code !== 200) throw new Error(\"status \" + pm.response.code); });",
                  "pm.test(\"tanpa error GraphQL\", () => { if (b.errors) throw new Error(JSON.stringify(b.errors)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($e:String!,$p:String!,$n:String!){ register(email:$e,password:$p,name:$n){ id email } }",
                "variables": "{\n  \"e\": \"{{newEmail}}\",\n  \"p\": \"{{newPassword}}\",\n  \"n\": \"Pengguna Postman\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Tidak membuat sesi. Email yang sudah terdaftar mendapat respons yang sama (tidak membocorkan keberadaan akun)."
          }
        },
        {
          "name": "Verifikasi email (token dari Mailpit)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const to = pm.collectionVariables.get(\"newEmail\");",
                  "pm.sendRequest(pm.environment.get(\"mailpitUrl\") + \"/api/v1/search?query=\" + encodeURIComponent(\"to:\" + to), (e, list) => {",
                  "  if (e || !list.json().messages.length) throw new Error(\"email verifikasi belum sampai di Mailpit\");",
                  "  pm.sendRequest(pm.environment.get(\"mailpitUrl\") + \"/api/v1/message/\" + list.json().messages[0].ID, (e2, msg) => {",
                  "    const m = msg.json().Text.match(/token=([^\\s&]+)/);",
                  "    pm.collectionVariables.set(\"verifyToken\", decodeURIComponent(m[1]));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"HTTP 200\", () => { if (pm.response.code !== 200) throw new Error(\"status \" + pm.response.code); });",
                  "pm.test(\"tanpa error GraphQL\", () => { if (b.errors) throw new Error(JSON.stringify(b.errors)); });",
                  "pm.test(\"terverifikasi\", () => { if (b.data.verifyEmail !== true) throw new Error(); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($t:String!){ verifyEmail(token:$t) }",
                "variables": "{\n  \"t\": \"{{verifyToken}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Pre-request mengambil tautan verifikasi dari API Mailpit (SMTP tangkap-semua dev)."
          }
        },
        {
          "name": "Masuk (akun baru)",
          "event": [
