generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  COMMUNITY_VERIFIED
  OFFICIAL
}

enum ChannelType {
  PRIVACY_EMAIL
  DPO_EMAIL
  REQUEST_FORM
  POSTAL_ADDRESS
  PRIVACY_POLICY_URL
}

enum RuleStatus {
  VERIFIED
  NEEDS_CONFIRMATION
  NOT_VERIFIED
}

// REVIEWED dan COMPLETED sengaja DIPERTAHANKAN sementara (D-003): penghapusannya ikut penulisan ulang state machine, bukan fase ini.
enum RequestStatus {
  DRAFT
  REVIEWED
  SENT
  ACKNOWLEDGED
  RESPONDED
  OVERDUE
  ESCALATED
  COMPLETED
  CLOSED
}

enum CloseReason {
  CANCELLED
  WITHDRAWN
  RESOLVED
  UNRESOLVED
}

enum DeadlineBasis {
  SENT_ESTIMATE
  RECEIVED
}

enum EvidenceSource {
  USER_UPLOADED
  SYSTEM_RECORDED
  VERIFIED
  DISPUTED
}

enum ResponseCategory {
  ACKNOWLEDGED
  ADDITIONAL_INFO_REQUESTED
  IN_PROGRESS
  FULFILLED
  PARTIALLY_FULFILLED
  REJECTED
  NO_RESPONSE
  OTHER
}

// Perilaku perusahaan simulasi (hanya perusahaan isDemo, aktif bila DEMO_MODE=true).
enum SimBehavior {
  REPLIES
  REPLIES_LATE
  SILENT
}

enum ReminderKind {
  APPROACHING
  PASSED
  FOLLOW_UP
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  name            String
  role            Role                @default(USER)
  emailVerifiedAt DateTime?
  tokenVersion    Int                 @default(0)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  requests        PrivacyRequest[]
  notifications   Notification[]
  submissions     ChannelSubmission[]
  dossierExports  DossierExport[]
  reports         ModerationReport[]
}

model Company {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  brand       String?
  legalName   String?
  industry    String
  website     String?
  isDemo      Boolean             @default(false)
  simulation  SimBehavior?
  notes       String?
  createdAt   DateTime            @default(now())
  channels    PrivacyChannel[]
  requests    PrivacyRequest[]
  submissions ChannelSubmission[]

  @@index([industry])
  @@index([name])
}

model PrivacyChannel {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          ChannelType
  value         String
  status        VerificationStatus @default(UNVERIFIED)
  sourceUrl     String?
  lastCheckedAt DateTime?
  note          String?
  requests      PrivacyRequest[]

  @@unique([companyId, type, value])
  @@index([companyId, status])
}

model ChannelSubmission {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       ChannelType
  value      String
  sourceUrl  String
  status     SubmissionStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime         @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

model DataRight {
  code                    String            @id
  article                 String
  title                   String
  plainMeaning            String
  needs                   String[]
  requiresRecordedRequest Boolean           @default(true)
  sortOrder               Int
  templates               RequestTemplate[]
  rules                   LegalRule[]
}

model LegalRule {
  id             String     @id @default(cuid())
  ruleKey        String
  version        Int
  rightCode      String
  right          DataRight  @relation(fields: [rightCode], references: [code])
  legalBasis     String
  triggerEvent   String     @default("REQUEST_RECEIVED")
  durationHours  Int?
  calcMethod     String     @default("CALENDAR_HOURS")
  applicability  String?
  exceptions     String?
  sourceRef      String?
  status         RuleStatus
  verifiedBy     String?
  lastReviewedAt DateTime?
  effectiveFrom  DateTime
  supersededAt   DateTime?
  deadlines      Deadline[]

  @@unique([ruleKey, version])
  @@index([rightCode, effectiveFrom])
}

model RequestTemplate {
  id        String    @id @default(cuid())
  rightCode String
  right     DataRight @relation(fields: [rightCode], references: [code])
  version   Int
  body      String
  active    Boolean   @default(true)

  @@unique([rightCode, version])
}

model PrivacyRequest {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  rightCode       String
  channelId       String?
  channel         PrivacyChannel?   @relation(fields: [channelId], references: [id])
  status          RequestStatus     @default(DRAFT)
  closeReason     CloseReason?
  title           String
  fields          Json
  letterBody      String            @default("")
  templateVersion Int?
  sentAt          DateTime?
  sentVia         String?
  receivedAt      DateTime?
  overdueAt       DateTime?
  escalatedAt     DateTime?
  closedAt        DateTime?
  followUpDays    Int               @default(14)
  version         Int               @default(0)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deadline        Deadline?
  events          TimelineEvent[]
  evidence        Evidence[]
  responses       CompanyResponse[]
  reminders       Reminder[]
  dossierExports  DossierExport[]
  emailDeliveries EmailDelivery[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId, rightCode])
  @@index([channelId])
  @@index([status, sentAt])
}

model Deadline {
  id          String         @id @default(cuid())
  requestId   String         @unique
  request     PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        LegalRule      @relation(fields: [ruleId], references: [id])
  ruleVersion Int            @default(1)
  basis       DeadlineBasis  @default(SENT_ESTIMATE)
  timeScale   Int            @default(1)
  startedAt   DateTime
  dueAt       DateTime?
  timezone    String
  basisNote   String
  completedAt DateTime?

  @@index([dueAt])
  @@index([ruleId])
}

model TimelineEvent {
  id           String         @id @default(cuid())
  requestId    String
  request      PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type         String
  actor        String
  actorId      String? // pengguna pelaku; null untuk SYSTEM
  description  String
  occurredAt   DateTime       @default(now())
  metadata     Json?
  verification EvidenceSource @default(SYSTEM_RECORDED)
  evidenceId   String?

  @@index([requestId, occurredAt])
}

model Evidence {
  id           String         @id @default(cuid())
  requestId    String
  request      PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storageKey   String         @unique
  originalName String
  mime         String
  size         Int
  sha256       String
  source       EvidenceSource @default(USER_UPLOADED)
  createdAt    DateTime       @default(now())

  @@index([requestId])
}

model CompanyResponse {
  id         String           @id @default(cuid())
  requestId  String
  request    PrivacyRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category   ResponseCategory
  note       String?
  receivedAt DateTime
  evidenceId String?
  simulated  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([requestId, receivedAt])
}

model Reminder {
  id          String         @id @default(cuid())
  requestId   String
  request     PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind        ReminderKind
  fireAt      DateTime
  ruleVersion Int?
  queuedAt    DateTime?
  firedAt     DateTime?
  attempts    Int            @default(0)
  lastError   String?

  @@unique([requestId, kind])
  @@index([fireAt, firedAt])
  @@map("ScheduledReminder")
}

model Notification {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId      String?
  type           String
  title          String
  body           String
  dedupeKey      String    @unique
  readAt         DateTime?
  emailedAt      DateTime? // waktu email pengingat diterima SMTP; null = belum terkirim
  emailClaimedAt DateTime? // sewa klaim pengiriman (kedaluwarsa setelah EMAIL_LEASE_MS bila instance mati)
  createdAt      DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  type          String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?

  @@index([publishedAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

model DossierExport {
  id            String         @id @default(cuid())
  requestId     String
  request       PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentSha256 String
  ruleVersion   Int?
  eventCount    Int
  createdAt     DateTime       @default(now())

  @@index([requestId, createdAt])
}

// STRETCH (risiko R4): laporan konten kanal/usulan yang keliru. Tabel disiapkan, belum ada resolver.
model ModerationReport {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id])
  entity     String
  entityId   String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}

// Bukti kirim email: message-id dari SMTP, waktu, dan hash isi (subjek + badan). Tidak menyimpan isi.
model EmailDelivery {
  id            String          @id @default(cuid())
  requestId     String?
  request       PrivacyRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind          String // REQUEST | REMINDER
  toAddress     String
  subject       String
  messageId     String
  contentSha256 String
  sentAt        DateTime

  @@index([requestId, sentAt])
}
