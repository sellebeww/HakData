{
  "name": "hak-data",
  "private": true,
  "author": "Vassel Goleyu",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build:shared": "pnpm --filter @hakdata/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @hakdata/api --filter @hakdata/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm build:shared && pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm --filter @hakdata/api test",
    "test:int": "pnpm build:shared && pnpm --filter @hakdata/api test:int",
    "e2e": "pnpm --filter @hakdata/web exec playwright test",
    "db:migrate": "pnpm --filter @hakdata/api db:push",
    "db:seed": "pnpm --filter @hakdata/api db:seed",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "graphql": "16.9.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.23.0"
  }
}
